# Discord Bot Configuration
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_NICKNAME_CHANNEL_ID=
DISCORD_LIVE_CHANNEL_ID=
DISCORD_WINNER_CLAIM_CHANNEL_ID=1535215403834544158

# ── Webhook Server (required for Twitch EventSub & YouTube WebSub) ──
# Externally reachable HTTPS URL (e.g. https://your-bot.onrender.com)
PUBLIC_BASE_URL=
# Internal port for HTTP server (default: same as PORT or 3000)
WEBHOOK_PORT=3000

# ── Recovery / Reconciliation (NOT primary detection) ──
SOCIAL_TRACKER_RECONCILE_INTERVAL_SECONDS=300

# ── Twitch EventSub ──
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Random secret string for Twitch EventSub HMAC verification (you create this)
TWITCH_EVENTSUB_SECRET=

# ── YouTube Data API ──
YOUTUBE_API_KEY=

# ── TikTok (Self-Hosted Mode) ──
# Provider name: 'self-hosted' (default / free HTML parser) or custom
TIKTOK_PROVIDER=self-hosted
# Optional: Only needed if using a custom paid third-party API provider
TIKTOK_API_KEY=
TIKTOK_API_BASE_URL=
# Only set if your custom provider supports real webhook push events
TIKTOK_WEBHOOK_SECRET=
# Near-real-time polling interval (default: 10 seconds; clamped to 5-300 seconds)
TIKTOK_POLL_INTERVAL_SECONDS=10
# Coalesces command checks with nearby background polls to prevent duplicate fetches
TIKTOK_STATUS_CACHE_MS=5000
BOT_DASHBOARD_SYNC_MS=3000
# Abort an individual TikTok page request if it hangs (default: 10 seconds)
TIKTOK_REQUEST_TIMEOUT_MS=10000
