{
  "name": "vanguard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "tsc -b && vite build",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "preview": "vite preview",
    "bot:nickname": "node --env-file-if-exists=.env.local --env-file-if-exists=.env bot/nickname-bot.js",
    "test:announce": "node --test bot/announce.test.js",
    "test:guess-the-number": "node --test bot/guess-the-number.test.js",
    "test:game-results-reader": "node --test bot/game-results-reader.test.js",
    "test:game-results-local": "node --test bot/game-results-local-reader.test.js",
    "test:game-results-scoreboard": "node --test bot/game-results-scoreboard-commands.test.js",
    "test:game-results-deployment": "node --test bot/game-results-deployment.test.js",
    "test:game-results-round": "node --test bot/game-results-round-reader.test.js",
    "test:game-results-mapping": "node --test bot/game-results-team-mapper.test.js",
    "test:game-results-review": "node --test bot/game-results-review.test.js",
    "test:game-results-sheet-write": "node --test bot/game-results-sheet-writer.test.js",
    "test:game-results-history": "node --test bot/game-results-player-history.test.js",
    "test:game-results-mvp": "node --test bot/game-results-mvp.test.js",
    "test:game-results-admin": "node --test bot/game-results-admin.test.js",
    "test:game-results-hardening": "node --test bot/game-results-hardening.test.js",
    "test:game-results-tournament": "node --test bot/game-results-tournament.test.js",
    "preflight:game-results-sheet": "node --env-file-if-exists=.env.local --env-file-if-exists=.env bot/game-results-sheet-live-preflight.js"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "discord.js": "^14.27.0",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.4",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.169.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.8.26",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vercel": "^56.5.0",
    "vite": "^5.4.11"
  }
}
